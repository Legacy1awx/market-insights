# Copy to .env for local development. On Vercel, add the same variables under
# Project → Settings → Environment Variables.

# Supabase Auth uses only the public anon/publishable key in the browser.
# VITE_* values are baked into the client at build time.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase credentials for admin and email APIs. Never use VITE_ here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email alerts. All five must be set or email features stay disabled.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# The deployed site address, e.g. https://your-app.vercel.app (https required).
PUBLIC_SITE_URL=
# Random string of at least 32 characters, used to sign unsubscribe links.
EMAIL_TOKEN_SECRET=

# Optional: message returned by GET /api/ping.
PING_MESSAGE=
